{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "andragon-desktop",
  "version": "0.1.0",
  "identifier": "com.emmelab.andragon",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --prefix ../andragon",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Andragon",
        "width": 1200,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}